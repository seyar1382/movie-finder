<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiTest.MainPage"> 

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">

            <Image
                x:Name="motvLogo"
                WidthRequest="200"/>

            <Label
                Text="Movies. Series. Streaming."
                Style="{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel="Level1" />

            <SearchBar
                HorizontalTextAlignment="Center"
                VerticalTextAlignment="Center"
                x:Name="searchBar" 
                FontSize="20"
                Placeholder="Search for movies..."
                HeightRequest="30" />

            <Button
                x:Name="searchButton"
                Clicked="OnSearchClicked"
                Text="Search"
                SemanticProperties.Hint="Search for movies" />

            <FlexLayout                
                FlexLayout.AlignSelf="Center"
                JustifyContent="Center">
                <Button
                    x:Name="movieTab" 
                    Text="Movies"
                    FlexLayout.Grow="1"
                    BackgroundColor="#FF5F2D78"
                    Margin="0,0,5,0"
                    Clicked="OnMoviesTabClicked"/>
                <Button 
                    x:Name="showTab" 
                    Text="TV Shows"
                    FlexLayout.Grow="1"
                    BackgroundColor="#FF362141"
                    Clicked="OnShowsTabClicked"/>
            </FlexLayout>

            <FlexLayout 
                x:Name="movieResults"
                Wrap="Wrap"
                JustifyContent="Center"
                AlignItems="Stretch"/>

        </VerticalStackLayout>

    </ScrollView>
</ContentPage>
